# --- Zorunlu: e-posta / IMAP kimlik bilgileri ---
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# --- Opsiyonel: aşağıdakilerin hepsinin makul varsayılanı var (src/config.py) ---

# Qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=emails
# Retrieval: bu cosine skorunun altındaki sonuçlar elenir (0.0-1.0). Düşürmek recall
# artırır (kısa/diller-arası sorgular), yükseltmek precision artırır.
# RETRIEVAL_SCORE_THRESHOLD=0.4

# Embedding modeli
# EMBED_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# Embedder cihazı: cpu | cuda (boş=otomatik). API sunucusu (main.py) bunu otomatik
# "cpu" yapar; çünkü embedder ile LLM aynı GPU'da çakışınca CUDA hatası/NaN oluşuyor.
# Toplu indekslemede (store_embeddings) GPU için boş bırakın veya cuda verin.
# EMBED_DEVICE=

# LLM
# LLM_MODEL_PATH=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# LLM_N_CTX=4096

# CORS (virgülle ayrılmış origin listesi)
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API erişim token'ı (ayarlanırsa veri uçları "Authorization: Bearer <token>" ister)
# Frontend için aynı değeri build sırasında VITE_API_TOKEN olarak verin.
# Ağa açık/üretim kurulumlarında MUTLAKA güçlü, rastgele bir değer verin
# (ör: `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# API_TOKEN=

# REQUIRE_AUTH=1 ise API_TOKEN zorunlu olur; token yoksa uygulama başlamaz
# (fail-closed). Docker imajında varsayılan 1'dir. Yerelde token'sız çalışmak
# istiyorsanız ayarlamayın (varsayılan kapalı, yalnızca uyarı loglanır).
# REQUIRE_AUTH=
